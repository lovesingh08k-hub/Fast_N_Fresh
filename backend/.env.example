# MongoDB
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://your_mongodb_username:your_mongodb_password@your-cluster.mongodb.net/fastnfresh_cafe?retryWrites=true&w=majority

# JWT
JWT_EXPIRES_IN=7d
JWT_SECRET=your_jwt_secret_here

# Rate limiting
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# Server
NODE_ENV=production
PORT=5000

# Seed Admin
SEED_ADMIN_NAME=Admin
SEED_ADMIN_USERNAME=your_admin_username
SEED_ADMIN_PASSWORD=your_admin_password
SEED_ADMIN_PHONE=your_admin_phone

# Seed Manager
SEED_MANAGER_NAME=Vikas
SEED_MANAGER_USERNAME=your_manager_username
SEED_MANAGER_PASSWORD=your_manager_password
SEED_MANAGER_PHONE=your_manager_phone

# Seed Staff
SEED_STAFF_NAME=Rahul
SEED_STAFF_USERNAME=your_staff_username
SEED_STAFF_PASSWORD=your_staff_password
SEED_STAFF_PHONE=your_staff_phone

# Web Menu
WEB_MENU_BASE_URL=https://lovesingh08k-hub.github.io/Fast_N_Fresh

# Customer online payments — leave empty until a real PSP adapter/credentials are configured.
PAYMENT_PROVIDER=
